      "typeVersion": 4.2,
      "id": "804e6de1-02d8-4b28-8e57-a6dcec5b8154",
      "notes": "Fetches the HTML content of the source Telegram channel"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Get the data\nlet post = $json.post;\nlet rawId = $json.postIdNumber; \nlet photoRaw = $json.photo;\nlet video = $json.video;\n\n// 2. Transform ID and Telegram Link\nif (rawId && typeof rawId === 'string') {\n    $json.postLink = `https://t.me/${rawId}`;\n    $json.postId = parseInt(rawId.split('/').pop());\n    \n    // ADDED: Create matching field for Merge node\n    $json.channelName = rawId.split('/')[0].trim(); \n} else {\n    $json.postId = 0;\n    $json.channelName = null;\n}\n\n// 3. Clean Photo URL\nif (photoRaw && typeof photoRaw === 'string') {\n    if (photoRaw.includes('url')) {\n        let match = photoRaw.match(/url\\(['\"]?([^'\"]+)['\"]?\\)/);\n        $json.photo = match ? match[1] : photoRaw;\n    }\n} else {\n    $json.photo = null;\n}\n\n// 4. Video Pass-through\n$json.video = video || null;\n\n// 5. Clean up post text (Signature & Link logic)\nconst signature = $('Set Telegram Channels').first().json.channelSignature;\n\nif (typeof post === 'string') {\n    // Convert HTML entities back to symbols\n    let decodedPost = post\n        .replace(/&gt;/g, '>')\n        .replace(/&lt;/g, '<')\n        .replace(/&amp;/g, '&')\n        .replace(/&quot;/g, '\"');\n\n    // Remove signature\n    if (signature) {\n        const escaped = signature.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n        decodedPost = decodedPost.replace(new RegExp(escaped, 'g'), '');\n    }\n\n    // Identify links\n    let linkRegex = /(https?:\\/\\/[^\\s\\[\\]>]+)/g;\n    let links = decodedPost.match(linkRegex);\n    let lastLink = links ? links[links.length - 1] : null;\n\n    let cleanText = decodedPost\n        .replace(/>>>/g, '') // Now correctly matches the decoded >>>\n        .replace(linkRegex, '') \n        .replace(/\\[[^\\]]+\\]/g, '') \n        .trim();\n\n    $json.post = lastLink ? `${cleanText}\\n\\n${lastLink}` : cleanText;\n}\nreturn $json;"
      },
      "name": "Clean Post Content",
      "type": "n8n-nodes-base.code",
      "position": [
        1904,
        720
      ],
      "notesInFlow": true,
      "typeVersion": 2,
      "id": "75051408-1285-4d2d-881f-ba75717b1374",
      "notes": "Removes original channel signature and cleans up the text"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Get the current photo value\nlet photo = $json.photo;\n\n// 2. If it's still wrapped in CSS background-image:url('...'), clean it\nif (photo && typeof photo === 'string' && photo.includes('url(')) {\n    // This regex is much safer and won't throw 'Unmatched )'\n    const match = photo.match(/url\\(['\"]?([^'\"]+)['\"]?\\)/i);\n    \n    if (match && match[1]) {\n        $json.photo = match[1];\n    }\n}\n\n// 3. Return the modified item\nreturn $json;"
      },
