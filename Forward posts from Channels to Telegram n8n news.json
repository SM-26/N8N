    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\n// Get signature from the 'Set Telegram Channels' node if it exists\nlet signature = \"\";\ntry {\n    signature = $('Set Telegram Channels').first().json.channelSignature;\n} catch (e) {}\n\nfor (const item of items) {\n    const messages = item.json.messageHtml || [];\n    const messageArray = Array.isArray(messages) ? messages : [messages];\n    \n    let skipNextPost = false;\n\n    for (const html of messageArray) {\n        if (!html || typeof html !== 'string') continue;\n\n        // 0. Sponsored Content Check\n        if (html.includes('תוכן שיווקי')) {\n            skipNextPost = true;\n            continue; \n        }\n        if (skipNextPost) {\n            skipNextPost = false;\n            continue;\n        }\n\n        // 1. Extract ID & Channel\n        const idMatch = html.match(/href=\"https:\\/\\/t\\.me\\/([a-zA-Z0-9_]+\\/\\d+)\"/i);\n        const rawId = idMatch ? idMatch[1] : null;\n        if (!rawId) continue;\n\n        const channelName = rawId.split('/')[0].trim();\n        const postId = parseInt(rawId.split('/').pop());\n\n        // 2. Extract Photo (Ignore Emojis)\n        const photoMatch = html.match(/background-image\\s*:\\s*url\\(['\"]?([^'\")]+)['\"]?\\)/i);\n        let photoUrl = photoMatch ? photoMatch[1] : null;\n        if (photoUrl && (photoUrl.includes('telegram.org') || photoUrl.startsWith('//'))) {\n            photoUrl = null;\n        }\n\n        // 3. Extract Video\n        const videoMatch = html.match(/<video[^>]*src\\s*=\\s*[\"']([^\"']+)[\"']/i);\n        \n        // 4. Extract and Clean Text\n        const textMatch = html.match(/js-message_text[^>]*>([\\s\\S]*?)<\\/div>/i);\n        let rawText = textMatch ? textMatch[1] : \"\";\n        \n        let decodedText = rawText\n            .replace(/<br\\s*\\/?>/gi, '\\n') \n            .replace(/&gt;/g, '>')\n            .replace(/&lt;/g, '<')\n            .replace(/&amp;/g, '&')\n            .replace(/&quot;/g, '\"')\n            .replace(/<[^>]*>?/gm, '');\n\n        // 4.1 Signature removal\n        if (signature && decodedText.includes(signature)) {\n            const escaped = signature.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n            decodedText = decodedText.replace(new RegExp(escaped, 'g'), '');\n        }\n\n        // 4.2 Footer removal (Comments / Response links)\n        // This removes \"תגובה אחת\", \"5 תגובות\", or the \"כדי להגיב...\" phrase from the end\n        decodedText = decodedText\n            .replace(/(תגובה אחת|\\d+\\s+תגובות|כדי להגיב לכתבה לחצו כאן)\\s*$/g, '')\n            .trim();\n\n        // 4.3 Body link handling\n        let linkRegex = /(https?:\\/\\/[^\\s\\[\\]>]+)/g;\n        let links = decodedText.match(linkRegex);\n        let lastLink = links ? links[links.length - 1] : null;\n\n        let finalPostText = decodedText\n            .replace(/>>>/g, '') \n            .replace(linkRegex, '') \n            .replace(/\\[[^\\]]+\\]/g, '') \n            .trim();\n\n        if (lastLink) {\n            finalPostText += `\\n\\n${lastLink}`;\n        }\n\n        output.push({\n            json: {\n                postIdNumber: rawId,\n                postId: postId,\n                channelName: channelName,\n                photo: photoUrl,\n                video: videoMatch ? videoMatch[1] : null,\n                post: finalPostText,\n                postLink: `https://t.me/${rawId}`\n            }\n        });\n    }\n}\n\nreturn output;"
      },
